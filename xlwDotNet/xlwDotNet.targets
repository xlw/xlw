<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="16.0">
  <PropertyGroup>
    <cplatform>$(Platform)</cplatform>
    <cplatform Condition=" '$(Platform)' == 'x86' ">Win32</cplatform>
    <cplatform Condition=" '$(Platform)' == 'AnyCPU' and '$(RuntimeIdentifier)' == 'win-x86' ">Win32</cplatform>
    <cplatform Condition=" '$(Platform)' == 'AnyCPU' and '$(RuntimeIdentifier)' == 'win-x64' ">x64</cplatform>
    <gd></gd>
    <gd Condition=" '$(Configuration)' == 'Debug' ">-gd</gd>
    <XLWDOTNETBIN>$(XLWDOTNETDIR)\lib\$(cplatform)\$(Configuration)\$(TargetFramework)</XLWDOTNETBIN>
    <XLWAttributesAssembly>$(XLWDOTNETBIN)\xlwDotNet.Attributes.dll</XLWAttributesAssembly>
    <XLWGeneratedSource Condition=" '$(XLWGeneratedSource)' == '' ">_xlwAutoGeneratedSource</XLWGeneratedSource>
    <XLWNativeAot Condition=" '$(XLWNativeAot)' == '' ">true</XLWNativeAot>
    <AllowUnsafeBlocks Condition=" '$(XLWNativeAot)' == 'true' ">true</AllowUnsafeBlocks>
    <XLWNativeAotRid Condition=" '$(cplatform)' == 'Win32' ">win-x86</XLWNativeAotRid>
    <XLWNativeAotRid Condition=" '$(cplatform)' == 'x64' ">win-x64</XLWNativeAotRid>
    <XLWNativeAotOutput>$(MSBuildProjectDirectory)\obj\xlw-native-aot\$(Configuration)\$(XLWNativeAotRid)\publish</XLWNativeAotOutput>
    <ProjectName Condition=" '$(ProjectName)' == '' ">$(MSBuildProjectName)</ProjectName>
    <AssemblyName>$(ProjectName).NET</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(XLWGeneratedSource)\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="xlwDotNet.Attributes">
      <HintPath>$(XLWAttributesAssembly)</HintPath>
    </Reference>
    <Reference Include="$(XLWDOTNETBIN)\xlwDotNet-vc143-mt$(gd)-$(XLWVersion).dll"
               Condition=" '$(XLWNativeAot)' != 'true' ">
      <HintPath>$(XLWDOTNETBIN)\xlwDotNet-vc143-mt$(gd)-$(XLWVersion).dll</HintPath>
    </Reference>
    <Compile Remove="$(XLWGeneratedSource)\XlwAotExports.g.cs" />
  </ItemGroup>

  <Target Name="IncludeXlwAotExports" BeforeTargets="CoreCompile"
          Condition=" '$(RuntimeIdentifier)' != '' ">
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)\$(XLWGeneratedSource)\XlwAotExports.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateAotWrappers" AfterTargets="Build"
          Condition=" '$(XLWNativeAot)' == 'true' and '$(RuntimeIdentifier)' == '' ">
    <MakeDir Directories="$(XLWGeneratedSource)\ag" />
    <Exec ConsoleToMsBuild="true"
          Command="$(XLWDOTNETBIN)\DotNetInterfaceGenerator.exe &quot;$(OutputPath)$(AssemblyName).dll&quot; $(MSBuildProjectName) $(XLWGeneratedSource) DLL AOT" />
  </Target>

  <Target Name="GenerateManagedWrappers" AfterTargets="Build"
          Condition=" '$(XLWNativeAot)' != 'true' and '$(RuntimeIdentifier)' == '' ">
    <MakeDir Directories="$(XLWGeneratedSource)\ag" />
    <Exec ConsoleToMsBuild="true"
          Command="$(XLWDOTNETBIN)\DotNetInterfaceGenerator.exe &quot;$(OutputPath)$(AssemblyName).dll&quot; $(MSBuildProjectName) $(XLWGeneratedSource) DLL" />
  </Target>

  <Target Name="GenerateExcelRegistration"
          AfterTargets="GenerateAotWrappers;GenerateManagedWrappers"
          Condition=" '$(RuntimeIdentifier)' == '' ">
    <Exec ConsoleToMsBuild="true"
          Command="$(XLWBIN)\InterfaceGenerator.exe $(XLWGeneratedSource)\DLL.h $(XLWGeneratedSource)\ag\xlwXLL.cpp" />
  </Target>

  <Target Name="PublishXlwNativeAot"
          AfterTargets="GenerateExcelRegistration"
          Condition=" '$(XLWNativeAot)' == 'true' and '$(RuntimeIdentifier)' == '' ">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration) --framework $(TargetFramework) --runtime $(XLWNativeAotRid) --output &quot;$(XLWNativeAotOutput)&quot; -p:Platform=$(Platform) -p:PublishAot=true -p:NativeLib=Shared -p:SelfContained=true" />
  </Target>

  <Target Name="BuildAotXLL" AfterTargets="PublishXlwNativeAot"
          Condition=" '$(XLWNativeAot)' == 'true' and '$(RuntimeIdentifier)' == '' ">
    <Copy SourceFiles="@(xlwcppprojectFiles)" DestinationFolder="$(MSBuildProjectDirectory)\$(XLWGeneratedSource)" />
    <MSBuild Targets="Build" Projects="$(XLWGeneratedSource)\XLL.vcxproj"
             Properties="BuildConfig=true;XLWNativeAot=true;CLRSupport=false;XLWROOT=$(XLWROOT);XLWVersion=$(XLWVersion);OutputPath=$(OutputPath);XLLNAME=$(ProjectName);XLWTF=$(TargetFramework);TargetFramework=$(TargetFramework);Platform=$(cplatform);Configuration=$(Configuration)" />
    <Copy SourceFiles="$(XLWNativeAotOutput)\$(AssemblyName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)\$(XLWGeneratedSource)\..\$(Configuration)\$(cplatform)\$(TargetFramework)" />
  </Target>

  <Target Name="BuildManagedXLL" AfterTargets="GenerateExcelRegistration"
          Condition=" '$(XLWNativeAot)' != 'true' and '$(RuntimeIdentifier)' == '' ">
    <Copy SourceFiles="@(xlwcppprojectFiles)" DestinationFolder="$(MSBuildProjectDirectory)\$(XLWGeneratedSource)" />
    <MSBuild Targets="Build" Projects="$(XLWGeneratedSource)\XLL.vcxproj"
             Properties="BuildConfig=true;XLWNativeAot=$(XLWNativeAot);XLWROOT=$(XLWROOT);XLWVersion=$(XLWVersion);OutputPath=$(OutputPath);XLLNAME=$(ProjectName);CLRSupport=NetCore;XLWTF=$(TargetFramework);TargetFramework=$(TargetFramework);Platform=$(cplatform);Configuration=$(Configuration)" />
  </Target>
</Project>
